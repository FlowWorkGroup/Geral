# Configure localmente; nunca submeta uma chave real ao Git.
# Para inferência local gratuita (sem chave externa):
ASTRA_TWIN_PROVIDER=ollama
ASTRA_TWIN_MODEL=qwen3:4b
ASTRA_TWIN_BASE_URL=http://localhost:11434/v1
# Para OpenAI, use ASTRA_TWIN_PROVIDER=openai e configure OPENAI_API_KEY.
OPENAI_API_KEY=
ASTRA_TWIN_REASONING=high
ASTRA_TWIN_DB=~/.astra-twin/memory.sqlite3
ASTRA_TWIN_MAX_HISTORY=12
ASTRA_TWIN_MAX_INPUT_CHARS=12000
# Interface web autenticada; gere segredos únicos e mantenha-os apenas no .env local.
ASTRA_TWIN_WEB_PASSWORD=
ASTRA_TWIN_WEB_SECRET=
ASTRA_TWIN_WEB_HOST=127.0.0.1
ASTRA_TWIN_WEB_PORT=8765
ASTRA_TWIN_WEB_COOKIE_SECURE=0
